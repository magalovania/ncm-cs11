# NeteaseCloudMusicApi Enhanced — cloned at build time, prod deps only.
FROM node:20-alpine
RUN apk add --no-cache git
WORKDIR /app
ARG API_REF=v4.40.1
RUN git clone --depth 1 --branch "$API_REF" https://github.com/NeteaseCloudMusicApiEnhanced/api-enhanced /app \
 && npm install --omit=dev --ignore-scripts --registry=https://registry.npmmirror.com
ENV NODE_ENV=production
EXPOSE 3000
CMD ["node","app.js"]
